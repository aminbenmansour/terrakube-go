# Terrakube Go configuration. Copy to .env and adjust for local development.
# The binaries read the process environment; they do not parse this file.
# Use `make run-api` (which exports nothing) or `env $(grep -v '^#' .env | xargs) make run-api`.

TERRAKUBE_ENV=dev
TERRAKUBE_LOG_LEVEL=debug
TERRAKUBE_PUBLIC_URL=http://localhost:8080

TERRAKUBE_HTTP_ADDR=:8080
TERRAKUBE_EXECUTOR_HTTP_ADDR=:8081
TERRAKUBE_REGISTRY_HTTP_ADDR=:8082

TERRAKUBE_DATABASE_URL=postgres://terrakube@localhost:5432/terrakube?sslmode=disable
TERRAKUBE_REDIS_URL=redis://localhost:6379/0
TERRAKUBE_AUTO_MIGRATE=true
TERRAKUBE_SHUTDOWN_TIMEOUT=15s

# Leave empty to disable the bearer-token check during local development.
TERRAKUBE_AUTH_TOKEN=

# local | s3
TERRAKUBE_STORAGE_TYPE=local
TERRAKUBE_STORAGE_LOCAL_PATH=.data

# Only used when TERRAKUBE_STORAGE_TYPE=s3. Set the access key and secret to
# the MinIO root credentials (see the container logs) or your S3 provider.
TERRAKUBE_STORAGE_S3_BUCKET=terrakube
TERRAKUBE_STORAGE_S3_REGION=us-east-1
TERRAKUBE_STORAGE_S3_ENDPOINT=http://localhost:9000
TERRAKUBE_STORAGE_S3_ACCESS_KEY_ID=
TERRAKUBE_STORAGE_S3_SECRET_ACCESS_KEY=
TERRAKUBE_STORAGE_S3_USE_PATH_STYLE=true
